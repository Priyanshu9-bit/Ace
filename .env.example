# Port the server listens on (most hosts set this for you).
PORT=3001

# Largest table size (2-26). 13 players = 4 cards each.
MAX_PLAYERS=13

# How long a finished round stays on the table before cards fly to the winner (ms).
TRICK_PAUSE_MS=1800

# If the player whose turn it is has disconnected, the server plays a random legal card
# for them after this long (ms) so the table never stalls.
AUTOPLAY_DELAY_MS=20000

# How long a dropped player keeps their seat in the LOBBY before it is freed (ms).
LOBBY_GRACE_MS=30000

# Rooms with nobody connected are deleted after this long (ms).
ROOM_IDLE_MS=600000

# Set to "false" to run the server API-only (no static website).
SERVE_CLIENT=true
