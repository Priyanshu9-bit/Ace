{
  "name": "ace",
  "version": "1.0.0",
  "private": true,
  "description": "Ace real-time multiplayer application",
  "workspaces": ["server", "client"],
  "scripts": {
    "build": "npm run build --workspace client",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node server/src/index.js",
    "dev": "concurrently -n server,client \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": { "node": ">=18" }
}
